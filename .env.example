
# ── Auth (one of these is required) ──
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# ── Runtime ──
# CONTAINER_RUNTIME=docker  # docker or bubblewrap
# CONTAINER_TIMEOUT=1800000
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5
# LOG_LEVEL=info

# ── Assistant ──
# ASSISTANT_NAME=Andy

# ── VNC (browser viewing) ──
ENABLE_VNC=false
# VNC_PASSWORD=
# VNC_RESOLUTION=1280x1024x24
# VNC_PORT=5900
# NOVNC_PORT=6080

# ── Channels ──
TELEGRAM_BOT_TOKEN=
