# Telegram bot - get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Default chat to receive scheduled-task notifications.
# Find your chat_id by messaging @userinfobot on Telegram, or
# read the first incoming update from your bot.
TELEGRAM_CHAT_ID=

# Absolute path to your Obsidian vault on the host. Quote if the path has spaces.
# This is the *host* path. docker-compose bind-mounts it to /vault inside
# the container. The container then re-exports VAULT_PATH=/vault (in
# docker-compose.yml's `environment:` block) so the daemons see the
# in-container path, not the host one. Same variable name, two values
# by design - don't try to "unify" them.
#
# Skill files reference <vault> as a placeholder - runtime resolves to
# /vault in Docker. Personal skills live at <vault>/persona/.claude/skills/<name>/
# and are mirrored into the repo's .claude/skills/<name>/ via bin/pbackup.sh
# / bin/pstore.sh (auto-pushed to vault on each Claude Code Stop hook).
#
# Default: ./Obsidian (a sibling folder inside the repo, gitignored). Override
# with any absolute path. /setup resolves relative paths to absolute before
# writing here.
VAULT_PATH="./Obsidian"

# Timezone (IANA name, e.g., America/New_York, Asia/Shanghai, Europe/London).
# setup.sh auto-detects host TZ and prompts; falls back to America/New_York
# at the docker-compose layer if .env doesn't set it.
TZ=America/New_York

# ============================================================================
# API / model provider  (optional — leave this whole block empty for the
# default: Anthropic OAuth via `claude /login`)
# ============================================================================
# setup.sh offers three auth paths; they are mutually exclusive, so set ONE:
#
#   1) OAuth      — leave this whole block empty, run `claude /login`.
#   2) API key      — set ANTHROPIC_API_KEY only (official api.anthropic.com).
#   3) Local router — set ANTHROPIC_BASE_URL/AUTH_TOKEN + the keys below.
#
# Only path 3 splits vision/text: the router (bin/anthropic-router.ts,
# supervised by the watchdog) listens on ROUTER_PORT and routes by content —
#   text-only  → DeepSeek native API (ROUTER_TEXT_MODEL, prefix caching)
#   image/text → OpenRouter, Anthropic-format pass-through (ROUTER_VISION_MODEL)
# Paths 1 & 2 use Anthropic's unified multimodal models.

# Path 2 — official Anthropic API key (sk-ant-...). Leave blank for OAuth/router.
ANTHROPIC_API_KEY=

# Path 3 — point Claude Code at the local router. ANTHROPIC_AUTH_TOKEN can be any
# non-empty string — the router authenticates upstream with DEEPSEEK_API_KEY /
# OPENROUTER_API_KEY, not this token.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
#
# Tier→model labels Claude Code sends. The router overrides model by content,
# so these are mostly cosmetic; set them to the short model name you expect.
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=
#
# Upstream credentials + routing targets.
# DeepSeek (text path) — model is a bare DeepSeek model name.
DEEPSEEK_API_KEY=
ROUTER_TEXT_MODEL=deepseek-chat
# OpenRouter (vision path) — model is a provider/model slug.
OPENROUTER_API_KEY=
ROUTER_VISION_MODEL=google/gemini-2.0-flash-001
ROUTER_PORT=8787

# Voyage AI embeddings — used by the kb skill for semantic search. Optional.
# VOYAGE_MIN_GAP_MS throttles requests to stay under rate limits.
VOYAGE_API_KEY=
VOYAGE_MIN_GAP_MS=50
