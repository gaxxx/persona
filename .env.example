# Telegram bot - get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# Default chat to receive scheduled-task notifications.
# Find your chat_id by messaging @userinfobot on Telegram, or
# read the first incoming update from your bot.
TELEGRAM_CHAT_ID=

# Absolute path to your Obsidian vault on the host.
# Inside the container this is mounted at /vault.
# Skill files reference <vault> as a placeholder - runtime resolves to /vault in Docker.
VAULT_PATH=/path/to/your/Obsidian/vault

# Timezone used for cron prompts (anything in IANA tz database).
TZ=America/New_York
