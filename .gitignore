node_modules/
data/
~
.env
.DS_Store
.claude/settings.local.json
.claude/scheduled_tasks.lock
.mcp.json
Obsidian

# Per-user files - kept in <vault>/persona/ and symlinked into the repo root
# (templates: CLAUDE.example.md, CRON.example.md). Setup wizard wires this up.
CLAUDE.md
CRON.md

# Personal skill content lives in <vault>/persona/.claude/skills/ and is
# symlinked into .claude/skills/ per-skill by bin/link-skills.sh. The setup
# skill is tracked so /setup is available on a fresh clone before any vault
# is wired up.
.claude/skills/*
!.claude/skills/setup
!.claude/skills/setup/**

# Editor swap files
*.swp
*.swo
